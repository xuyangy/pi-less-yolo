# syntax=docker/dockerfile:1

# oh-my-pi (omp) variant of the pi-less-yolo sandbox. Same runtime hardening as
# the pi image — the run flags come from the shared tasks/pi/_docker_flags — but
# omp ships as prebuilt npm packages on Bun rather than Node, so the build is a
# single stage: no Rust toolchain and no native compilation (upstream's own
# Dockerfile builds pi_natives from source; @oh-my-pi/pi-natives is that addon,
# already built).
FROM oven/bun:1.3.14-slim@sha256:d56a2534ffd262e92c12fd3249d3924d296d97086da773f821d7d0477435ea04

USER root

# ripgrep + fd: omp's search tools shell out to these.
# python3: omp runs a persistent Python kernel for its code-execution tool.
# openssh-client: git-over-SSH (PI_SSH_AGENT=1).
# tini: PID 1 reaping for the long-lived TUI, which spawns subprocesses.
# shellcheck + shfmt: not tools omp calls directly — bash-language-server shells
#   out to them for diagnostics and formatting, and degrades to parse-only
#   completion without them. See the language-server layer below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        fd-find \
        git \
        openssh-client \
        python3 \
        python3-venv \
        ripgrep \
        shellcheck \
        shfmt \
        tini \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# BUN_INSTALL before the global install so packages land in a world-readable
# path. Bun's default (~/.bun) would put them under root's home, unreadable by
# the non-root runtime UID.
ENV BUN_INSTALL=/usr/local/bun
ENV PATH="/usr/local/bun/bin:${PATH}"

# Pinned, like pi in the sibling Dockerfile. Renovate tracks both.
# @oh-my-pi/pi-natives is the prebuilt Rust addon; it must match the agent version.
RUN bun install -g \
        @oh-my-pi/pi-coding-agent@17.2.7 \
        @oh-my-pi/pi-natives@17.2.7 \
    && chmod -R a+rX /usr/local/bun

# LANGUAGE SERVERS
#
# omp has an `lsp` tool but ships no servers. src/lsp/defaults.json declares ~53
# of them as nothing more than a `command` plus `args`, and loadConfig() keeps
# only the ones whose binary resolves (project-local bin dir first, then $PATH)
# AND whose root markers match the cwd. A server that is not in the image never
# starts and says nothing — there is no runtime install path either, since the
# runtime UID has no package manager and no root.
#
# Each of these is invoked by the exact `command` its defaults.json entry names,
# so the binary name is the contract — not the package name. All of them run on
# Bun's node shim (/usr/local/bun-node-fallback-bin/node, which the base image
# symlinks to bun); verified by driving a real LSP `initialize` handshake
# against every one of them inside this image.
#
#   typescript                        tsserver, which the next line drives
#   typescript-language-server        .ts .tsx .js .jsx
#   basedpyright                      .py .pyi   -> basedpyright-langserver
#   bash-language-server              .sh .bash  -> shellcheck/shfmt above
#   yaml-language-server              .yaml .yml
#   vscode-langservers-extracted      .json (also html/css/eslint, for free)
#   dockerfile-language-server-nodejs Dockerfile -> docker-langserver
#   @ansible/ansible-language-server  the vscode-ansible server; see .lsp.yml
#
# typescript is held at 5.x on purpose: typescript-language-server drives
# tsserver, and the 7.x package (the native port) no longer ships tsserver.js —
# a 7.x bump would leave the TS server unable to start. renovate.json pins that
# ceiling so a bot cannot lift it.
#
# The stamp file and `-cnewer` are a layer-size guard, not a style choice. The
# a+rX pass exists for the same reason as the one above — Bun leaves some files
# unreadable to a non-matching UID — but a plain `chmod -R /usr/local/bun` here
# would rewrite the metadata of every file the previous layer installed, and
# copy-on-write would duplicate that whole gigabyte into this layer. Restricting
# it to inodes created by this RUN keeps the layer at the size of what it adds.
# ctime rather than mtime: npm tarballs carry fixed archive timestamps, so a
# freshly extracted file can have an mtime decades in the past.
RUN touch /tmp/lsp.stamp \
    && bun install -g \
        # renovate: datasource=npm depName=typescript
        typescript@5.9.3 \
        # renovate: datasource=npm depName=typescript-language-server
        typescript-language-server@5.3.0 \
        # renovate: datasource=npm depName=basedpyright
        basedpyright@1.39.9 \
        # renovate: datasource=npm depName=bash-language-server
        bash-language-server@5.6.0 \
        # renovate: datasource=npm depName=yaml-language-server
        yaml-language-server@1.24.0 \
        # renovate: datasource=npm depName=vscode-langservers-extracted
        vscode-langservers-extracted@4.10.0 \
        # renovate: datasource=npm depName=dockerfile-language-server-nodejs
        dockerfile-language-server-nodejs@0.15.0 \
        # renovate: datasource=npm depName=@ansible/ansible-language-server
        @ansible/ansible-language-server@26.6.0 \
    && find /usr/local/bin /usr/local/bun -cnewer /tmp/lsp.stamp -exec chmod a+rX {} + \
    && rm /tmp/lsp.stamp

# lua-language-server is a compiled binary, not an npm package, so it comes from
# the upstream release tarball with its SHA-256 checked — the same
# verify-what-you-download posture the pi image applies to mise.
#
# MANUAL BUMP. Deliberately not handed to Renovate: the version and the two
# per-arch digests have to move together, and a bot that understands only the
# version would open PRs that fail the checksum. To update, change LLS_VERSION
# and both digests in one edit.
#
# The wrapper redirects logpath and metapath into $HOME. The server writes to
# <install-root>/log by default, which is root-owned here and unwritable by the
# runtime UID; $HOME is 1777, so any UID the run tasks pass can write there.
ARG TARGETARCH
# SC2016 is the point, not a mistake: the wrapper's $HOME and $XDG_CACHE_HOME
# must survive into the generated script and be expanded when the runtime UID
# runs it, not baked to root's values at build time.
# hadolint ignore=SC2016
RUN set -eu \
    && LLS_VERSION=3.19.0 \
    && case "${TARGETARCH}" in \
        amd64) LLS_ARCH=linux-x64;  LLS_SHA=624ae8dd3bfbd5c2ee3ccf2f3547d33aeefa209971cce8c11d48f69fc1ec065a ;; \
        arm64) LLS_ARCH=linux-arm64; LLS_SHA=f625d3955c8cb2962b65f26970fa7caa502ed6ed448686aa0ffaa23a59ebd454 ;; \
        *) echo "unsupported TARGETARCH '${TARGETARCH}' for lua-language-server" >&2; exit 1 ;; \
    esac \
    && curl -fsSL -o /tmp/lls.tar.gz \
        "https://github.com/LuaLS/lua-language-server/releases/download/${LLS_VERSION}/lua-language-server-${LLS_VERSION}-${LLS_ARCH}.tar.gz" \
    && printf '%s  %s\n' "${LLS_SHA}" /tmp/lls.tar.gz > /tmp/lls.sha256 \
    && sha256sum -c /tmp/lls.sha256 \
    && rm /tmp/lls.sha256 \
    && mkdir -p /opt/lua-language-server \
    && tar -xzf /tmp/lls.tar.gz -C /opt/lua-language-server \
    && rm /tmp/lls.tar.gz \
    && chmod -R a+rX /opt/lua-language-server \
    && printf '%s\n' \
        '#!/bin/sh' \
        '# Keep writable state out of the root-owned install root.' \
        'LLS_STATE="${XDG_CACHE_HOME:-$HOME/.cache}/lua-language-server"' \
        'exec /opt/lua-language-server/bin/lua-language-server \' \
        '  --logpath="${LLS_STATE}/log" --metapath="${LLS_STATE}/meta" "$@"' \
        > /usr/local/bin/lua-language-server \
    && chmod 0755 /usr/local/bin/lua-language-server

# Python and Ansible tooling that is not npm-shaped, in one venv so it cannot
# collide with the project interpreters omp resolves per workspace.
#
# ruff        omp's `ruff server` entry: lint diagnostics alongside basedpyright.
# ansible-lint the diagnostics half of the ansible server, and it brings
#             ansible-core with it — ansible-language-server shells out to
#             ansible-doc/ansible-config/ansible-playbook and is close to inert
#             without them.
#
# ansible-core only, NOT the `ansible` distribution: the latter bundles every
# community collection and would add roughly a gigabyte. Collections that a
# playbook actually needs belong in the project (ansible-galaxy installs into
# the workspace, which is mounted read-write).
#
# The symlinks are what put these on $PATH — the venv's bin directory is
# deliberately not prepended, so nothing here shadows a project's own python.
RUN set -eu \
    && python3 -m venv /opt/omp-python \
    && /opt/omp-python/bin/pip install --no-cache-dir --quiet \
        # renovate: datasource=pypi depName=ruff
        ruff==0.16.4 \
        # renovate: datasource=pypi depName=ansible-lint
        ansible-lint==26.8.0 \
    && for _bin in ruff ansible ansible-config ansible-doc ansible-galaxy \
                   ansible-inventory ansible-lint ansible-playbook ansible-vault; do \
        ln -s "/opt/omp-python/bin/${_bin}" "/usr/local/bin/${_bin}"; \
    done \
    && chmod -R a+rX /opt/omp-python

# Approval-mode floor. omp defaults to `yolo`, which auto-approves the `exec`
# tier — shelling out, driving a browser, spawning subagents — with no prompt.
# This overlay lowers that to `write`: read and write are still automatic, exec
# prompts.
#
# Delivered as a PI_CONFIG_FILES overlay rather than written into the mounted
# state dir, so it applies without mutating the user's own config.yml. A session
# can still opt out explicitly with `omp --yolo`.
#
# The same file also carries a bash.patterns deny/prompt list, which — unlike
# approvalMode — keeps applying under `--yolo`. That is what `mise run omp:yolo`
# is built on. See omp-hardened.yml for the mechanism and the syntax rules.
# The mkdir is load-bearing: a bare COPY creates missing parents with the same
# --chmod as the file, and a 0444 directory has no traversal bit, so the runtime
# UID cannot read the overlay at all. omp then starts with upstream defaults —
# yolo, no patterns — and says nothing. Create the directory 0755 first.
RUN mkdir -p /etc/omp && chmod 0755 /etc/omp
COPY --chmod=0444 omp-hardened.yml /etc/omp/hardened.yml
# Layered on top only by `mise run omp:yolo`, which overrides PI_CONFIG_FILES.
# Present but inert for every other task.
COPY --chmod=0444 omp-yolo.yml /etc/omp/yolo.yml
ENV PI_CONFIG_FILES=/etc/omp/hardened.yml

# Same layout rationale as the pi image: world-writable $HOME so any runtime UID
# can write, root-owned .ssh that a non-matching UID can still read into, and a
# world-writable /etc/passwd so the entrypoint can register the runtime UID
# (SSH's getpwuid(3) hard-fails without one). Safe because the run tasks pass
# --cap-drop=ALL and --no-new-privileges, and the image defaults to non-root.
RUN mkdir -p /home/ompuser /home/ompuser/.ssh \
    && chmod 1777 /home/ompuser \
    && chmod 755 /home/ompuser/.ssh \
    && chmod a+w /etc/passwd \
    && touch /home/ompuser/.ssh/known_hosts \
    && chmod 666 /home/ompuser/.ssh/known_hosts

ENV HOME=/home/ompuser

# Ansible server definition; omp ships no default for it. Lands at the
# lowest-priority LSP config location, after the mkdir above so the 0444 mode
# applies to the file and not to a COPY-created $HOME — the same trap the
# /etc/omp comment describes. See omp-lsp.yml for why it is a config file.
COPY --chmod=0444 omp-lsp.yml /home/ompuser/.lsp.yml

# The Bun base image sets WORKDIR /home/bun/app, owned by uid 1000 and not
# traversable by the runtime UID. omp probes <cwd>/.omp for project config, so
# inheriting that directory makes a bare `docker run` fail with EACCES. The run
# tasks always pass --workdir "$(pwd)"; this only fixes the default.
WORKDIR /home/ompuser

# Shared with the pi image; PI_ENTRY_CMD selects which agent it execs.
COPY --chmod=755 entrypoint.sh /usr/local/bin/entrypoint.sh
ENV PI_ENTRY_CMD=omp

# Fail closed to a non-root UID: the run tasks always pass --user, so this only
# governs a bare `docker run`, where the alternative would be root.
USER 65532:65532

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
