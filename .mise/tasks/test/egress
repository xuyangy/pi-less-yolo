#!/usr/bin/env bash
#MISE description="Verify PI_EGRESS=proxy allows the allowlist and blocks everything else, including direct egress"
set -euo pipefail

REPO_ROOT="${MISE_TASK_DIR}/../../.."

# shellcheck source=tasks/pi/_runtime
source "${REPO_ROOT}/tasks/pi/_runtime"

failures=0

# Preflight starts no containers and needs no network, so these run before the
# skips below.
# shellcheck source=tasks/pi/_egress
source "${REPO_ROOT}/tasks/pi/_egress"

preflight() {
  # A subshell so an `exit 1` from a conflict check does not end this script.
  ( PI_EGRESS="$1" PI_LOCAL_MODELS="$2" PI_SSH_AGENT="$3" _pi_egress_preflight ) 2>&1
}

expect_preflight() {
  local desc="$1" pattern="$2"; shift 2
  local out
  out="$(preflight "$@" || true)"
  if grep -qE "${pattern}" <<< "${out}" || { [[ -z "${pattern}" ]] && [[ -z "${out}" ]]; }; then
    echo "  OK ${desc}"
  else
    echo "  FAIL ${desc} (output: ${out:-<empty>})"
    failures=$((failures + 1))
  fi
}

expect_preflight "PI_LOCAL_MODELS conflict is a hard error" "cannot be combined" proxy 1 ""
expect_preflight "PI_SSH_AGENT conflict warns"              "PI_SSH_AGENT=1 has no effect" proxy "" 1
expect_preflight "unknown mode is rejected"                 "is not a known mode" bogus "" ""
expect_preflight "proxy alone is silent"                    "" proxy "" ""
expect_preflight "egress off is silent"                     "" off "" 1

# The rest needs network access to a known-good host, so it is skipped when the
# runner has none rather than reported as a failure.
if ! curl -s --max-time 10 -o /dev/null https://example.com/; then
  echo "  SKIP no network access from the host"
  [ "${failures}" -eq 0 ] || { echo "FAIL: ${failures} egress check(s) failed"; exit 1; }
  exit 0
fi

# The --internal network and the sidecar's second attachment are only verified
# on Docker so far; the README says as much. Skipping is honest, whereas a red
# CI run on the podman matrix would imply the feature is broken rather than
# unverified.
if [[ "${DOCKER_CMD}" == "podman" ]]; then
  echo "  SKIP egress proxy is not verified on podman"
  [ "${failures}" -eq 0 ] || { echo "FAIL: ${failures} egress check(s) failed"; exit 1; }
  exit 0
fi

# Run the build task by path rather than as `mise run pi:egress-build`. The pi:
# and omp: tasks only exist once `mise run install` has registered the tasks/
# directory globally; CI checks the repo out and never installs, so the task name
# does not resolve there and this failed with "no task pi:egress-build found".
# Invoking the script directly reuses its build flags (including the Linux
# --network=host workaround) without depending on that registration.
if ! "${DOCKER_CMD}" image inspect pi-egress:latest > /dev/null 2>&1; then
  MISE_TASK_DIR="${REPO_ROOT}/tasks/pi" bash "${REPO_ROOT}/tasks/pi/egress-build"
fi

CURL_IMAGE="curlimages/curl:8.11.1"
"${DOCKER_CMD}" pull -q "${CURL_IMAGE}" > /dev/null

DOCKER_FLAGS=()
export PI_EGRESS=proxy
export PI_EGRESS_ALLOW="example.com"

_pi_egress_start > /dev/null 2>&1
trap '_pi_egress_stop' EXIT

# The generated config must be readable by the sidecar's UID (65532), which is
# not the invoking user. mktemp -d is 0700, and on Linux a bind mount passes
# host mode and ownership straight through, so without an explicit chmod
# tinyproxy cannot read its config and the proxy exits on startup. Docker
# Desktop on macOS remaps ownership and hides this, so assert the host-side mode
# rather than trying to observe the failure — that check holds on every platform.
# Read the rwx string rather than an octal mode: `stat` takes -c on GNU and -f on
# BSD, and each silently means something else to the other. /bin/ls bypasses any
# `ls` alias on the host.
perms_of() { /bin/ls -ld "$1" | cut -c1-10; }

dir_perms=$(perms_of "${_PI_EGRESS_CONFDIR}")
if [[ "${dir_perms}" == ???????r?x ]]; then
  echo "  OK proxy config dir is world-traversable (${dir_perms})"
else
  echo "  FAIL proxy config dir is ${dir_perms}; the sidecar UID cannot traverse it"
  failures=$((failures + 1))
fi

for f in tinyproxy.conf filter; do
  f_perms=$(perms_of "${_PI_EGRESS_CONFDIR}/${f}")
  if [[ "${f_perms}" != ???????r?? ]]; then
    echo "  FAIL ${f} is ${f_perms}; the sidecar UID cannot read it"
    failures=$((failures + 1))
  fi
done

# The proxy must still be running: a config it cannot read makes it exit at once,
# which would otherwise only surface as confusing connection failures below.
if [ -n "$("${DOCKER_CMD}" ps -q --filter "name=${_PI_EGRESS_CONTAINER}")" ]; then
  echo "  OK proxy container is still running after startup"
else
  echo "  FAIL proxy container exited on startup"
  failures=$((failures + 1))
fi

# Creating a network that already exists must not abort: two first-time sessions
# can race, and the loser's "already exists" would otherwise kill the run. The
# subshell contains the `exit 1` that ensure_network uses on real failure.
if ( _pi_egress_ensure_network "${_PI_EGRESS_NET_INTERNAL}" --internal ); then
  echo "  OK re-creating an existing network is tolerated"
else
  echo "  FAIL ensure_network aborted on an existing network"
  failures=$((failures + 1))
fi

# A pre-existing network with the right name but the wrong topology must abort.
# Silently accepting a non-internal "internal" network would put the agent on an
# ordinary bridge with full direct egress while the session still reports the
# allowlist as active — the one failure mode that looks like success.
probe_net="pi-egress-probe-$$"
"${DOCKER_CMD}" network rm "${probe_net}" > /dev/null 2>&1 || true
"${DOCKER_CMD}" network create "${probe_net}" > /dev/null   # deliberately NOT --internal
if ( _pi_egress_ensure_network "${probe_net}" --internal ) 2> /dev/null; then
  echo "  FAIL ensure_network accepted a non-internal network as internal"
  failures=$((failures + 1))
else
  echo "  OK a non-internal network is refused where internal is required"
fi
"${DOCKER_CMD}" network rm "${probe_net}" > /dev/null 2>&1 || true

# The mirror image: an internal network where the proxy needs real egress would
# block every allowlisted request, so it is refused too rather than half-working.
probe_net_i="pi-egress-probe-i-$$"
"${DOCKER_CMD}" network rm "${probe_net_i}" > /dev/null 2>&1 || true
"${DOCKER_CMD}" network create --internal "${probe_net_i}" > /dev/null
if ( _pi_egress_ensure_network "${probe_net_i}" ) 2> /dev/null; then
  echo "  FAIL ensure_network accepted an internal network for external egress"
  failures=$((failures + 1))
else
  echo "  OK an internal network is refused where external egress is required"
fi
"${DOCKER_CMD}" network rm "${probe_net_i}" > /dev/null 2>&1 || true

# Asserts on curl's exit status, not the HTTP code: a blocked request never
# gets a response, and an allowed one may legitimately answer 401 (no API key).
check() {
  local desc="$1" expect="$2"; shift 2
  local rc=0
  "${DOCKER_CMD}" run --rm "${DOCKER_FLAGS[@]}" "${CURL_IMAGE}" "$@" > /dev/null 2>&1 || rc=$?
  if [[ "${expect}" == "ok" && "${rc}" -eq 0 ]] || [[ "${expect}" == "fail" && "${rc}" -ne 0 ]]; then
    echo "  OK ${desc}"
  else
    echo "  FAIL ${desc} (rc=${rc}, expected ${expect})"
    failures=$((failures + 1))
  fi
}

check "allowlisted host reachable through the proxy"  ok   -s --max-time 25 https://example.com/
check "default model provider reachable"              ok   -s --max-time 25 https://api.anthropic.com/v1/models
check "unlisted host blocked"                         fail -s --max-time 25 https://ifconfig.me/
check "suffix-spoofed host blocked"                   fail -s --max-time 20 https://example.com.egress-test.invalid/
check "CONNECT to a non-TLS port blocked"             fail -s --max-time 20 https://example.com:8080/

# The load-bearing ones: --internal means there is no route out even for a
# client that ignores the proxy env vars entirely.
check "direct egress bypassing the proxy blocked"     fail -s --max-time 15 --noproxy '*' https://example.com/
check "direct egress to a raw IP blocked"             fail -s --max-time 15 --noproxy '*' http://1.1.1.1/

[ "${failures}" -eq 0 ] || { echo "FAIL: ${failures} egress check(s) failed"; exit 1; }
echo "  OK egress allowlist enforced"
