#!/usr/bin/env bash
#MISE description="Build (or rebuild) the omp (oh-my-pi) Docker image"
set -euo pipefail

REPO_ROOT="${MISE_TASK_DIR}/../.."

# --network=host is only needed on Linux to work around systemd-resolved
# binding to 127.0.0.53, which is unreachable from Docker's default bridge
# network. Docker Desktop on macOS handles DNS natively without it. See
# tasks/pi/build for the permanent daemon-level fix.
DOCKER_CMD="${PI_CONTAINER_RUNTIME:-docker}"
BUILD_FLAGS=()
[[ "$(uname -s)" == "Linux" ]] && BUILD_FLAGS+=("--network=host")

# No --secret here: unlike the pi image, this build installs no GPG-verified
# tooling. omp ships as prebuilt npm packages pinned in Dockerfile.omp.
"${DOCKER_CMD}" build "${BUILD_FLAGS[@]}" \
  -f "${REPO_ROOT}/Dockerfile.omp" \
  -t "omp-less-yolo:latest" \
  "${REPO_ROOT}"

echo "Image 'omp-less-yolo:latest' built successfully."
