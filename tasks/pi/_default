#!/usr/bin/env bash
#MISE description="Run pi coding agent in a Docker container"
#MISE raw=true
#MISE dir="{{cwd}}"
set -euo pipefail

# Explicit, not relying on the default in _docker_flags: an exported _PI_VARIANT
# in the caller's shell would otherwise silently run the wrong agent.
_PI_VARIANT=pi
# shellcheck source=tasks/pi/_docker_flags
source "$(dirname "$0")/_docker_flags"

DOCKER_FLAGS+=("--interactive")
[ -t 0 ] && [ -t 1 ] && DOCKER_FLAGS+=("--tty")

# One trap for both teardowns: a second `trap ... EXIT` would silently replace
# this one rather than adding to it. The relay is stopped outside the tmux
# guard because notifications still fire without tmux — only the badge and
# spinner need a pane.
if [ -n "${TMUX:-}" ]; then
  tmux set-option -p allow-passthrough on 2>/dev/null || true
  trap '_cn_relay_stop; tmux set-option -p allow-passthrough off 2>/dev/null || true' EXIT
else
  trap '_cn_relay_stop' EXIT
fi

_cn_relay_start

PI_ARGS=()
if [[ -z "${PI_NO_CONTAINER_PROMPT:-}" ]]; then
  PI_ARGS+=(
    "--append-system-prompt"
    "You are running inside a Docker container as a non-root user. No Docker socket, sudo, or system package installation (apk requires root) is available."
  )
fi

"${DOCKER_CMD}" run "${DOCKER_FLAGS[@]}" "${PI_IMAGE}" "${PI_ARGS[@]}" "$@"
