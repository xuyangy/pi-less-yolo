#!/usr/bin/env bash
#MISE description="Run pi read-only: project directory mounted read-only, file-modification tools disabled"
#MISE raw=true
#MISE dir="{{cwd}}"
set -euo pipefail

_PI_WORKDIR_RO=1
# Explicit, not relying on the default in _docker_flags: an exported _PI_VARIANT
# in the caller's shell would otherwise silently run the wrong agent.
_PI_VARIANT=pi
# shellcheck source=tasks/pi/_docker_flags
source "$(dirname "$0")/_docker_flags"

DOCKER_FLAGS+=("--interactive")
[ -t 0 ] && [ -t 1 ] && DOCKER_FLAGS+=("--tty")

# A read-only session is still an agent session, so it gets the code-notify
# bridge like the default task. See _docker_flags.
#
# PI_EGRESS is honoured here and not in the default task on purpose: this is the
# "read a codebase I don't trust" path, so it carries the highest injection risk
# and the lowest need for network access — the best place for the allowlist to
# earn its friction. One trap for both teardowns; a second `trap ... EXIT` would
# replace rather than add.
trap '_cn_relay_stop; _pi_egress_stop' EXIT
_cn_relay_start
_pi_egress_start

"${DOCKER_CMD}" run "${DOCKER_FLAGS[@]}" "${PI_IMAGE}" --tools read,grep,find,ls "$@"
