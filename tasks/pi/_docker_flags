# Builds DOCKER_FLAGS for the agent container tasks. Source this file; do not
# execute directly.
# Usage: source "$(dirname "$0")/_docker_flags"
#
# Serves both agents. Set _PI_VARIANT=omp before sourcing to target the oh-my-pi
# image; unset or "pi" keeps the original behaviour byte for byte. Everything
# below the variant block — hardening flags, mounts, key forwarding, the
# PI_EXTRA_MOUNTS guards — is shared, so the two agents cannot drift apart on
# the security-relevant flags.
case "${_PI_VARIANT:-pi}" in
  pi)
    PI_IMAGE="pi-less-yolo:latest"
    _PI_BUILD_TASK="pi:build"
    _PI_STATE_HOST="${HOME}/.pi/agent"
    _PI_STATE_TARGET="/pi-agent"
    # PI_CODING_AGENT_DIR points pi at the mount instead of deriving it from
    # $HOME, sidestepping HOME-resolution issues inside the container.
    _PI_STATE_ENV="PI_CODING_AGENT_DIR=${_PI_STATE_TARGET}"
    _PI_HOME_TARGET="/home/piuser"
    ;;
  omp)
    PI_IMAGE="omp-less-yolo:latest"
    _PI_BUILD_TASK="omp:build"
    _PI_HOME_TARGET="/home/ompuser"
    # No PI_CONFIG_DIR here, deliberately. Unlike pi's PI_CODING_AGENT_DIR it is
    # NOT an absolute path — omp joins it under $HOME, so PI_CONFIG_DIR=/omp-home
    # resolves to /home/ompuser/omp-home/agent and silently misses the mount
    # (confirmed with `omp config path`). Mounting at omp's own default location
    # under the image's fixed HOME is simpler and cannot drift.
    _PI_STATE_HOST="${HOME}/.omp"
    _PI_STATE_TARGET="${_PI_HOME_TARGET}/.omp"
    _PI_STATE_ENV=""
    ;;
  *)
    echo "error: unknown _PI_VARIANT '${_PI_VARIANT}' (expected 'pi' or 'omp')" >&2
    exit 1
    ;;
esac

# Sets DOCKER_CMD. BASH_SOURCE, not $0: this file is sourced, so $0 is the caller.
# shellcheck source=tasks/pi/_runtime
source "$(dirname "${BASH_SOURCE[0]}")/_runtime"

# Defines _pi_egress_start/_pi_egress_stop (PI_EGRESS). Sourced here so both
# agents share one implementation, but — like the code-notify relay below — not
# invoked here: only a task that actually runs the agent should bring a proxy
# up, and it must pair the call with _pi_egress_stop in its EXIT trap.
# shellcheck source=tasks/pi/_egress
source "$(dirname "${BASH_SOURCE[0]}")/_egress"

"${DOCKER_CMD}" image inspect "${PI_IMAGE}" > /dev/null 2>&1 || mise run "${_PI_BUILD_TASK}"

# Pre-create so Docker doesn't auto-create it as root (breaking writes by the
# container's non-root UID).
mkdir -p "${_PI_STATE_HOST}"

# The whole containment story is "the agent only sees $(pwd)". That holds only
# if $(pwd) is actually a project directory: running from $HOME or / mounts your
# entire home (~/.ssh, ~/.aws, ~/.pi/agent) or the whole filesystem read-write.
# Refuse by default; PI_ALLOW_WIDE_MOUNT=1 is the deliberate override.
_pi_cwd="$(pwd -P)"
_pi_home="$(cd "${HOME}" && pwd -P)"
if [[ -z "${PI_ALLOW_WIDE_MOUNT:-}" ]]; then
  if [[ "${_pi_cwd}" == "/" || "${_pi_cwd}" == "${_pi_home}" ]]; then
    echo "error: refusing to mount '${_pi_cwd}' — this would give the agent" >&2
    echo "       read-write access to everything under it, including ~/.ssh." >&2
    echo "       cd into a project directory, or set PI_ALLOW_WIDE_MOUNT=1 to override." >&2
    exit 1
  fi
fi
unset _pi_cwd _pi_home

# Permissions:
#   --user $(id -u):$(id -g)   files created in /workspace are owned by the
#                               calling user on the host, not root.
#   --cap-drop=ALL             drop all Linux capabilities; pi needs none.
#   --no-new-privileges        prevent setuid binaries from gaining privileges.
#
# Mounts:
#   $(pwd):$(pwd)              current directory, mounted at its real host path.
#   <state>:<target>           agent config, credentials, sessions, and managed
#                               binaries from the host. The accompanying env var
#                               points the agent at the mount rather than
#                               deriving it from $HOME, sidestepping any
#                               HOME-resolution issues inside the container.
#                               See the variant block at the top for per-agent
#                               paths.
DOCKER_FLAGS=(
  "--rm"
  "--user" "$(id -u):$(id -g)"
  "--cap-drop=ALL"
  "--security-opt=no-new-privileges"
  "--ipc=none"
  "--volume" "$(pwd):$(pwd)${_PI_WORKDIR_RO:+:ro}"  # :ro set by the readonly task
  "--volume" "${_PI_STATE_HOST}:${_PI_STATE_TARGET}"
  "--workdir" "$(pwd)"
  "--env" "TERM=${TERM:-xterm-256color}"
  "--env" "COLORTERM=${COLORTERM:-truecolor}"
)

# Only pi needs an explicit state-dir env var; see the variant block.
[[ -n "${_PI_STATE_ENV}" ]] && DOCKER_FLAGS+=("--env" "${_PI_STATE_ENV}")

# Podman-specific: use --userns=keep-id to properly map the user namespace
# and avoid "crun: chown `/dev/pts/0`: Invalid argument" errors.
if [[ "${DOCKER_CMD}" == "podman" ]]; then
  DOCKER_FLAGS+=("--userns=keep-id")
fi

# Forward pi-related env vars and API keys if set on the host.
# Auth file (~/.pi/agent/auth.json) takes priority over these if present.
PI_ENV_VARS=(
  PI_SKIP_VERSION_CHECK
  PI_CACHE_RETENTION
  PI_PACKAGE_DIR
  VISUAL
  EDITOR
  ANTHROPIC_API_KEY
  # Both agents document this as an alternative to the API key (`pi --help`;
  # omp docs/environment-variables.md, where it outranks ANTHROPIC_API_KEY).
  # Note neither agent refreshes an injected token — when it expires, requests
  # fail until a fresh one is exported.
  ANTHROPIC_OAUTH_TOKEN
  AZURE_OPENAI_API_KEY
  OPENAI_API_KEY
  GEMINI_API_KEY
  MISTRAL_API_KEY
  GROQ_API_KEY
  CEREBRAS_API_KEY
  XAI_API_KEY
  OPENROUTER_API_KEY
  AI_GATEWAY_API_KEY
  ZAI_API_KEY
  OPENCODE_API_KEY
  KIMI_API_KEY
  MINIMAX_API_KEY
  MINIMAX_CN_API_KEY
)

# omp resolves a wider provider set than pi (docs/environment-variables.md).
# Appended only for the omp variant so pi's forwarded surface is unchanged;
# names that are unset on the host are skipped by the loop below either way.
if [[ "${_PI_VARIANT:-pi}" == "omp" ]]; then
  PI_ENV_VARS+=(
    ANTHROPIC_FOUNDRY_API_KEY
    GOOGLE_API_KEY
    FIREWORKS_API_KEY
    TOGETHER_API_KEY
    HUGGINGFACE_HUB_TOKEN
    HF_TOKEN
    NVIDIA_API_KEY
    LITELLM_API_KEY
    OMP_PROFILE
  )
fi

# Pass the NAME only, not name=value. Both docker and podman then read the value
# from their own environment, so API keys never appear in the `docker run` argv —
# where any local user could read them out of `ps aux`, and where they would be
# retained in the container config for `docker inspect`. These vars are by
# definition exported (this script inherited them), so the lookup succeeds.
for var in "${PI_ENV_VARS[@]}"; do
  [ -n "${!var:-}" ] && DOCKER_FLAGS+=("--env" "$var")
done

# code-notify bridge. The agent's own hook (installed on the host by
# `cn on pi` / `cn on omp` into the state directory already mounted above, so
# the container sees it as an ordinary auto-discovered hook) cannot deliver a
# notification from in here: no $TMUX, no host tmux socket, no notifier. It
# only writes one small file per lifecycle event into a spool directory, and
# the relay — started on the host, in the tmux pane this container renders
# into — turns those into notifications.
#
# No new mount and no new capability: the spool lives inside the state
# directory that is already bind-mounted. Opt out with PI_NO_CODE_NOTIFY=1.
#
# Defined here so pi and omp share it, but deliberately NOT started here: only
# a task that actually runs the agent should spool anything, so each such task
# calls _cn_relay_start itself and pairs it with _cn_relay_stop in its EXIT
# trap. `<agent>:shell` sources this file too and must stay untouched.
#
# The relay inherits TMUX/TMUX_PANE from this shell, which is how a
# notification ends up on the right pane. CODE_NOTIFY_RELAY_SESSION_PID is this
# launcher: when it is gone the session is over, and the relay uses that both
# to exit and to retire the running indicator if the container dies without a
# clean turn end.
_CN_SPOOL_HOST=""
_CN_RELAY_PID=""
_cn_relay_start() {
  [[ -z "${PI_NO_CODE_NOTIFY:-}" ]] || return 0
  command -v code-notify > /dev/null 2>&1 || return 0

  _CN_SPOOL_HOST="${_PI_STATE_HOST}/.code-notify/$$"
  if ! mkdir -p "${_CN_SPOOL_HOST}" 2> /dev/null; then
    echo "warning: could not create the code-notify spool at ${_CN_SPOOL_HOST} — notifications disabled for this run" >&2
    _CN_SPOOL_HOST=""
    return 0
  fi

  # Unlike the API keys above this is passed as name=value, because the value
  # is computed here rather than inherited. Safe precisely because it is a path
  # and not a secret: nothing is lost by it appearing in `docker inspect`.
  DOCKER_FLAGS+=("--env" "CODE_NOTIFY_SPOOL=${_PI_STATE_TARGET}/.code-notify/$$")

  CODE_NOTIFY_RELAY_SESSION_PID=$$ code-notify relay "${_PI_VARIANT:-pi}" "${_CN_SPOOL_HOST}" \
    < /dev/null > /dev/null 2>&1 &
  _CN_RELAY_PID=$!
}

# Every step tolerates failure (|| true): this runs from an EXIT trap under
# `set -e`, where a relay that already exited would otherwise turn a clean
# session into a non-zero exit.
_cn_relay_stop() {
  if [[ -n "${_CN_RELAY_PID}" ]]; then
    kill "${_CN_RELAY_PID}" 2> /dev/null || true
    # The relay retires the tmux running indicator on SIGTERM; give it that
    # moment before this shell exits.
    wait "${_CN_RELAY_PID}" 2> /dev/null || true
  fi
  if [[ -n "${_CN_SPOOL_HOST}" ]]; then
    rm -rf "${_CN_SPOOL_HOST}" 2> /dev/null || true
    # Non-recursive on purpose: it removes the shared parent only once the last
    # concurrent session is gone, and fails harmlessly while others are live.
    rmdir "$(dirname "${_CN_SPOOL_HOST}")" 2> /dev/null || true
  fi
  return 0
}

# Git identity: mount ~/.gitconfig read-only. Opt out with PI_NO_GITCONFIG=1.
# Credential helpers (e.g. osxkeychain) are unavailable; git falls back to prompting.
if [[ -z "${PI_NO_GITCONFIG:-}" && -f "${HOME}/.gitconfig" ]]; then
  DOCKER_FLAGS+=("--volume" "${HOME}/.gitconfig:${_PI_HOME_TARGET}/.gitconfig:ro")
fi

# Resource limits. Opt in by setting any of PI_MEMORY, PI_CPUS, or PI_PIDS_LIMIT.
# Examples: PI_MEMORY=4g PI_CPUS=2 PI_PIDS_LIMIT=512
[[ -n "${PI_MEMORY:-}" ]]     && DOCKER_FLAGS+=("--memory" "${PI_MEMORY}")
[[ -n "${PI_CPUS:-}" ]]       && DOCKER_FLAGS+=("--cpus" "${PI_CPUS}")
[[ -n "${PI_PIDS_LIMIT:-}" ]] && DOCKER_FLAGS+=("--pids-limit" "${PI_PIDS_LIMIT}")

# PI_LOCAL_MODELS=1: share the host network namespace so local model servers
# (Ollama, LM Studio, vLLM) are reachable at their native localhost URLs.
# Security: all host ports become reachable. macOS: uses the Docker Desktop VM
# network — localhost on the Mac is not reachable; use host.docker.internal.
if [[ -n "${PI_LOCAL_MODELS:-}" ]]; then
  DOCKER_FLAGS+=("--network=host")
fi

# PI_EXTRA_MOUNTS: semicolon-separated list of additional directory mounts.
# Format: source_path:container_path[:mode]
#   source — absolute path on the host (use $HOME, not ~)
#   target — path inside the container
#   mode   — rw (default) or ro
# Example:
#   export PI_EXTRA_MOUNTS="$HOME/.llm-wiki:/home/piuser/.llm-wiki;$HOME/.agents:/home/piuser/.agents"
#
# Container-runtime socket paths. Exposing one of these — directly, or by
# mounting any directory above it — lets the agent drive the host daemon and
# start a privileged container with / mounted, which is a full escape. AGENTS.md
# states the absent Docker socket as a security invariant, so this is enforced
# rather than warned about.
#
# Matching is on path, not on the socket existing right now: a bind mount of a
# parent directory stays live, so a socket that appears later would be exposed
# too.
_PI_RUNTIME_SOCKETS=(
  /var/run/docker.sock
  /run/docker.sock
  /var/run/containerd/containerd.sock
  /run/containerd/containerd.sock
  /var/run/crio/crio.sock
  /run/crio/crio.sock
  /var/run/podman/podman.sock
  /run/podman/podman.sock
  "${HOME}/.docker/run/docker.sock"
  "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker.sock"
  "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
)

# True when mounting $1 would expose a runtime socket at or beneath it.
_pi_exposes_runtime_socket() {
  local raw="$1" resolved sock base
  # Resolve symlinks (on many Linux distros /var/run is a link to /run) so a
  # symlinked spelling of the same directory cannot slip past the comparison.
  resolved=$(cd "${raw}" 2>/dev/null && pwd -P) || resolved="${raw}"
  for sock in "${_PI_RUNTIME_SOCKETS[@]}"; do
    for base in "${raw}" "${resolved}"; do
      [[ "${sock}" == "${base}" || "${sock}" == "${base%/}"/* ]] && return 0
    done
  done
  return 1
}

if [[ -n "${PI_EXTRA_MOUNTS:-}" ]]; then
  _pi_ifs="$IFS"
  IFS=';'
  for _pi_spec in ${PI_EXTRA_MOUNTS}; do
    [[ -z "${_pi_spec}" ]] && continue  # tolerate stray/trailing ';'

    if [[ "${_pi_spec}" =~ ^([^:]+):([^:]+)(:(rw|ro))?$ ]]; then
      _pi_src="${BASH_REMATCH[1]}"
      _pi_tgt="${BASH_REMATCH[2]}"
      _pi_mode="${BASH_REMATCH[4]:-rw}"
      if [[ "${_pi_src}" != /* || "${_pi_tgt}" != /* ]]; then
        # A relative source resolves against the caller's cwd, which is not what
        # anyone means here; a relative target is rejected by the runtime anyway.
        echo "warning: PI_EXTRA_MOUNTS entry '${_pi_spec}' uses a relative path (both source and target must be absolute) — skipping mount" >&2
      elif [[ -S "${_pi_src}" ]]; then
        # Bind-mounting the container runtime's own socket hands the agent full
        # control of the host daemon — it can start a privileged container and
        # mount /. No warning is sufficient here, so refuse outright.
        echo "error: PI_EXTRA_MOUNTS source '${_pi_src}' is a socket — refusing." >&2
        echo "       Mounting a container runtime socket gives the agent full host access." >&2
        exit 1
      elif _pi_exposes_runtime_socket "${_pi_src}"; then
        # Same escape, reached one level up: '/var/run' exposes
        # '/var/run/docker.sock' just as surely as naming the socket directly.
        echo "error: PI_EXTRA_MOUNTS source '${_pi_src}' contains a container runtime socket — refusing." >&2
        echo "       Mounting a directory above the runtime socket gives the agent full host access." >&2
        echo "       Mount a narrower path that does not enclose the socket." >&2
        exit 1
      elif [[ -e "${_pi_src}" ]]; then
        DOCKER_FLAGS+=("--volume" "${_pi_src}:${_pi_tgt}:${_pi_mode}")
      else
        echo "warning: PI_EXTRA_MOUNTS source '${_pi_src}' not found — skipping mount" >&2
      fi
    else
      echo "warning: PI_EXTRA_MOUNTS entry '${_pi_spec}' is malformed (expected source:target[:rw|ro]) — skipping" >&2
    fi
  done
  IFS="$_pi_ifs"
  unset _pi_ifs _pi_spec _pi_src _pi_tgt _pi_mode
fi

# SSH agent forwarding. Opt in by setting PI_SSH_AGENT=1.
# Also mounts ~/.ssh/known_hosts and ~/.ssh/config read-only.
# Security: a compromised container can authenticate as you to any server your
# agent has loaded. If ~/.ssh/config contains ForwardAgent yes, that forwarding
# cascades to any server the container connects to. Review loaded keys with
# `ssh-add -l` before enabling.
if [[ -n "${PI_SSH_AGENT:-}" ]]; then
  if [[ -f "${HOME}/.ssh/known_hosts" ]]; then
    DOCKER_FLAGS+=("--volume" "${HOME}/.ssh/known_hosts:${_PI_HOME_TARGET}/.ssh/known_hosts:ro")
  fi
  if [[ -f "${HOME}/.ssh/config" ]]; then
    DOCKER_FLAGS+=("--volume" "${HOME}/.ssh/config:${_PI_HOME_TARGET}/.ssh/config:ro")
  fi

  if [[ "$(uname -s)" == "Darwin" ]] && [[ "${DOCKER_CMD}" == "docker" ]]; then
    # Docker Desktop creates the socket root:root 660; add GID 0 so the
    # non-root user can access it. --cap-drop=ALL limits the exposure.
    DOCKER_FLAGS+=(
      "--mount" "type=bind,src=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock"
      "--env" "SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock"
      "--group-add" "0"
    )
  elif [[ -S "${SSH_AUTH_SOCK:-}" ]]; then
    DOCKER_FLAGS+=(
      "--volume" "${SSH_AUTH_SOCK:-}:${SSH_AUTH_SOCK:-}"
      "--env" "SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-}"
    )
  else
    echo "warning: PI_SSH_AGENT=1 but SSH_AUTH_SOCK is not set or is not a socket — SSH agent forwarding disabled" >&2
  fi
fi
