{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "github-actions": { "enabled": false },
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies", "renovate"],
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "enabled": false
    },
    {
      "matchDepNames": ["@earendil-works/pi-coding-agent"],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "MISE_VERSION=(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "mise",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "jdx/mise"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "mise (?:install|exec) uv@(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "astral-sh/uv"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "uv python install (?<currentValue>[\\d.]+)",
        "uv python find (?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "python/cpython",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/", "/^README\\.md$/"],
      "matchStrings": [
        "pi-coding-agent@(?<currentValue>[\\d.]+)",
        "pi--coding--agent-(?<currentValue>[\\d.]+)-blueviolet"
      ],
      "depNameTemplate": "@earendil-works/pi-coding-agent",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^tasks/pi/pi-acp$/"],
      "matchStrings": [
        "PI_ACP_VERSION=\"(?<currentValue>[\\d.]+)\""
      ],
      "depNameTemplate": "pi-acp",
      "datasourceTemplate": "npm"
    },
    {
      "description": "omp: pi-natives is the prebuilt addon for a specific pi-coding-agent release, so Dockerfile.omp requires both pins to match. Modelled as ONE dependency with two matchStrings (same approach as pi's Dockerfile+README badge) rather than two entries, which could otherwise produce a PR bumping only one and leaving an incompatible native addon.",
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile\\.omp$/"],
      "matchStrings": [
        "@oh-my-pi/pi-coding-agent@(?<currentValue>[\\d.]+)",
        "@oh-my-pi/pi-natives@(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "@oh-my-pi/pi-coding-agent",
      "datasourceTemplate": "npm"
    }
  ]
}
